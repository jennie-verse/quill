{
  "name": "Quill",
  "short_name": "Quill",
  "description": "A private, offline-friendly text editor for files saved through Files.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fffafa",
  "theme_color": "#fffafa",
  "orientation": "any",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
